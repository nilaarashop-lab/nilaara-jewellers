PORT=5000
# MongoDB Atlas (required). Local dev may omit this and use mongodb://127.0.0.1:27017/parinaya
# MONGO_URI=mongodb+srv://<db-user>:<db-pass>@cluster0.xxxxx.mongodb.net/parinaya
FRONTEND_URL=http://localhost:5173
# Absolute base URL of this API (used to build /uploads URLs in dev):
# PUBLIC_BASE_URL=http://localhost:5000
NODE_ENV=development

# ── Image storage ─────────────────────────────────────────────
# local | cloudinary | imagekit (local refuses to boot in production).
# Product & homepage images from the admin panel are stored in the
# "nilaara/products" folder of the configured provider.
STORAGE_DRIVER=cloudinary
# Cloudinary (only when STORAGE_DRIVER=cloudinary):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ImageKit (only when STORAGE_DRIVER=imagekit). Private key from
# ImageKit dashboard → Developer Options → API Keys → Private Key.
# Public key is optional (only for browser-side widgets, unused here);
# URL endpoint is optional and only needed with a custom CDN CNAME.
# STORAGE_DRIVER=imagekit
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_URL_ENDPOINT=https://your-cname.example
# Max per-image size / files per upload request:
MAX_UPLOAD_MB=5
MAX_UPLOAD_FILES=6
# Hosts allowed for pasted image URLs in the admin panel (comma separated).
# Leave empty in production — new images must come from the upload endpoint.
ALLOWED_IMAGE_HOSTS=

# ── Auth / sessions ───────────────────────────────────────────
# COOKIE_SECURE=true is forced in production; sessions are httpOnly cookies.
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
REGISTER_PER_IP=10

# ── Google Sign-In (optional) ─────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# The same value goes into frontend/.env as VITE_GOOGLE_CLIENT_ID (it is public).
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── Mobile OTP via real SMS provider (optional) ───────────────
# Provider: twofactor (2Factor.in, India), msg91, or twilio. Empty = OTP login off.
# See docs/AUTH.md for DLT sender-ID / template setup and billing notes.
# OTP_PROVIDER=twofactor
# TWOFACOR_API_KEY=            # API key from the 2Factor.in dashboard
# TWOFACOR_TEMPLATE=auto       # DLT-registered template name, or "auto"
# OTP_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=          # DLT-registered OTP template id
# MSG91_SENDER_ID=            # optional — DLT header
# MSG91_COUNTRY_CODE=91
# OTP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxx    # must be DLT-provisioned for Indian traffic
# TWILIO_SMS_TEMPLATE=Your Nilaara login OTP is {{code}}. Valid for 5 minutes. Do not share it with anyone.
# REQUIRED in production when OTP is enabled — long random string (e.g. `openssl rand -hex 32`):
# OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30

# ── Email OTP via Resend (optional) ───────────────────────────
# API key from https://resend.com/api-keys. The FROM domain must be verified
# in Resend (DNS records) or emails bounce. Empty = email OTP login off.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Nilaara Jewellers <otp@yourdomain.com>

# ── Dev-only seed accounts (scripts/seed-test-accounts.js) ────
# Used by `npm run seed:accounts` (development only — refused in production).
# Existing users are never overwritten. Leave empty for the built-in local defaults.
# SEED_CUSTOMER_EMAIL=
# SEED_CUSTOMER_PASSWORD=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ── Razorpay (optional — COD works without these) ─────────────
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx
