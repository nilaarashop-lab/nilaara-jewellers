# Public Google OAuth web client ID (Google Cloud Console → Credentials → OAuth 2.0 Client ID).
# This value is NOT secret — it is embedded in the browser bundle by Vite.
# The backend verifies every ID token; set the same value in backend/.env as GOOGLE_CLIENT_ID.
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=

# Backend API origin (set in production builds; without it the site runs in demo mode).
# VITE_API_URL=http://localhost:5000
